{
  "name": "@heliannuuthus/ui",
  "version": "0.1.0",
  "description": "Accessible shadcn-style React primitives for Heliannuuthus products",
  "license": "MIT",
  "packageManager": "pnpm@11.13.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heliannuuthus/ui.git"
  },
  "homepage": "https://ui.heliannuuthus.com",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "import": "./dist/hooks/*.js"
    },
    "./avatar": {
      "types": "./dist/avatar.d.ts",
      "import": "./dist/avatar.js"
    },
    "./alert": {
      "types": "./dist/alert.d.ts",
      "import": "./dist/alert.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.js"
    },
    "./card": {
      "types": "./dist/card.d.ts",
      "import": "./dist/card.js"
    },
    "./dialog": {
      "types": "./dist/dialog.d.ts",
      "import": "./dist/dialog.js"
    },
    "./dropdown-menu": {
      "types": "./dist/dropdown-menu.d.ts",
      "import": "./dist/dropdown-menu.js"
    },
    "./input": {
      "types": "./dist/input.d.ts",
      "import": "./dist/input.js"
    },
    "./label": {
      "types": "./dist/label.d.ts",
      "import": "./dist/label.js"
    },
    "./masonry": {
      "types": "./dist/masonry.d.ts",
      "import": "./dist/masonry.js"
    },
    "./radio": {
      "types": "./dist/radio.d.ts",
      "import": "./dist/radio.js"
    },
    "./separator": {
      "types": "./dist/separator.d.ts",
      "import": "./dist/separator.js"
    },
    "./spinner": {
      "types": "./dist/spinner.d.ts",
      "import": "./dist/spinner.js"
    },
    "./toast": {
      "types": "./dist/toast.d.ts",
      "import": "./dist/toast.js"
    },
    "./styles.css": "./dist/styles.css",
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @heliannuuthus/ui-docs dev",
    "build": "pnpm build:package && pnpm --filter @heliannuuthus/ui-docs build",
    "build:package": "tsup && tailwindcss -i src/styles/globals.css -o dist/styles.css --minify",
    "build:docs": "pnpm build:package && pnpm --filter @heliannuuthus/ui-docs build",
    "lint": "eslint src apps/docs/src --max-warnings=0",
    "format": "prettier --write \"{src,apps}/**/*.{ts,tsx,css,json,md}\"",
    "format:check": "prettier --check \"{src,apps}/**/*.{ts,tsx,css,json,md}\"",
    "type-check": "tsc --noEmit && pnpm --filter @heliannuuthus/ui-docs exec tsc --noEmit",
    "prepare": "pnpm build:package",
    "prepack": "pnpm build:package"
  },
  "peerDependencies": {
    "react": ">=18.3.0",
    "react-dom": ">=18.3.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@shadcn/react": "^0.2.1",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.468.0",
    "motion": "^12.42.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.2",
    "react-day-picker": "^10.0.1",
    "react-hook-form": "^7.62.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/cli": "^4.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.7",
    "lxgw-wenkai-screen-webfont": "1.7.0",
    "prettier": "^3.3.3",
    "shadcn": "4.13.1",
    "tailwindcss": "^4.1.0",
    "tsup": "^8.5.0",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.55.0",
    "zod": "4.4.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
