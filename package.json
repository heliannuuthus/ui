{
  "name": "@heliannuuthus/ui",
  "version": "0.1.0",
  "description": "Accessible shadcn-style React primitives for Heliannuuthus products",
  "license": "MIT",
  "packageManager": "pnpm@11.13.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heliannuuthus/ui.git"
  },
  "homepage": "https://ui.heliannuuthus.com",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/global.css"
  },
  "scripts": {
    "dev": "pnpm --filter @heliannuuthus/ui-docs dev",
    "build": "pnpm build:package && pnpm --filter @heliannuuthus/ui-docs build",
    "build:package": "tsup && node scripts/build-package.mjs && pnpm verify:package",
    "build:docs": "pnpm build:package && pnpm --filter @heliannuuthus/ui-docs build",
    "lint": "eslint src apps/docs/src scripts tsup.config.ts --max-warnings=0",
    "format": "prettier --write \"{src,apps}/**/*.{ts,tsx,css,json,md}\" \"scripts/**/*.mjs\" tsup.config.ts package.json",
    "format:check": "prettier --check \"{src,apps}/**/*.{ts,tsx,css,json,md}\" \"scripts/**/*.mjs\" tsup.config.ts package.json",
    "type-check": "tsc --noEmit && pnpm --filter @heliannuuthus/ui-docs exec tsc --noEmit",
    "prepare": "pnpm build:package",
    "prepack": "pnpm build:package",
    "verify:package": "node scripts/verify-package.mjs && node scripts/verify-button.mjs && node scripts/verify-pagination.mjs && node scripts/verify-scroll-area.mjs && node scripts/verify-semantic-styles.mjs && node scripts/verify-form-accessibility.mjs && node scripts/verify-typography.mjs && node scripts/verify-badge-tag.mjs"
  },
  "peerDependencies": {
    "react": ">=18.3.0",
    "react-dom": ">=18.3.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.468.0",
    "motion": "^12.42.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.2",
    "react-day-picker": "^10.0.1",
    "react-hook-form": "^7.62.0",
    "react-is": "^18.3.1",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.7",
    "@eslint/js": "^9.39.2",
    "@tailwindcss/cli": "^4.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@types/react-is": "^19.2.0",
    "esbuild": "^0.27.7",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.7",
    "lxgw-wenkai-screen-webfont": "1.7.0",
    "prettier": "^3.3.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "shadcn": "4.13.1",
    "tailwindcss": "^4.1.0",
    "tsup": "^8.5.0",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "zod": "4.4.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
